{
  "name": "javascript-library-starter",
  "version": "0.0.0",
  "description": "A modern starter template for building JavaScript libraries.",
  "keywords": [
    "javascript",
    "library-starter"
  ],
  "bugs": {
    "url": "https://github.com/ajiho/javascript-library-starter/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajiho/javascript-library-starter.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "pnpm run lint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "build:base": "rolldown -c",
    "build:min": "cross-env NODE_ENV=production run-s build:base",
    "build": "run-s clean build:* size",
    "test": "vitest --coverage",
    "test:ui": "pnpm run test --ui",
    "coverage": "vitest run --coverage",
    "publint": "publint",
    "check": "run-s lint coverage build publint"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.7",
    "rolldown-plugin-copy-files": "^0.2.0",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^13.0.3",
    "vitest": "^5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
