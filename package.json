{
  "name": "javascript-library-starter",
  "version": "0.0.0",
  "description": "A modern starter template for building JavaScript libraries.",
  "keywords": [
    "javascript",
    "library-starter"
  ],
  "bugs": {
    "url": "https://github.com/ajiho/javascript-library-starter/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajiho/javascript-library-starter.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "build:base": "rolldown -c",
    "build:min": "cross-env NODE_ENV=production run-s build:base",
    "build": "run-s clean build:* size",
    "test": "vitest --coverage --ui",
    "coverage": "vitest run --coverage",
    "publint": "publint",
    "check": "run-s lint coverage build publint"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.3",
    "rolldown-plugin-copy-files": "^0.2.0",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^13.0.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
